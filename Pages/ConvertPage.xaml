<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ConverPro.Pages.ConvertPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:ConverPro.Models" xmlns:vm="clr-namespace:ConverPro.ViewModels" x:DataType="vm:MainViewModel" Title="Converter vídeos">
 <Grid Padding="30,24" RowDefinitions="*,Auto" RowSpacing="16"><ScrollView><VerticalStackLayout Spacing="14"><Label Text="Converter vídeos" Style="{StaticResource PageTitle}"/><Label Text="Extraia o áudio de MP4, MKV, AVI, MOV e WebM." Style="{StaticResource PageSubtitle}"/><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="14">
  <HorizontalStackLayout Spacing="8"><Button Text="Selecionar vídeos" ImageSource="action_add.png" Style="{StaticResource SecondaryButton}" Clicked="Pick"/><Button Text="Remover selecionados" ImageSource="action_remove.png" Style="{StaticResource DangerButton}" Clicked="Remove"/></HorizontalStackLayout>
  <CollectionView ItemsSource="{Binding Conversions}" HeightRequest="320"><CollectionView.EmptyView><Label Text="Nenhum vídeo selecionado." Style="{StaticResource EmptyLabel}"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="models:MediaQueueItem"><Border Stroke="#E5EAF1" StrokeShape="RoundRectangle 8" Padding="8" Margin="0,2"><Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto,Auto"><CheckBox IsChecked="{Binding IsSelected}"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Title}"/><Label Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="11"/></VerticalStackLayout><Label Grid.Column="2" Text="{Binding StatusText}"/><ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Progress="{Binding Progress}"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout><Label Text="Formato de saída" Style="{StaticResource FieldLabel}"/><Picker ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding SelectedAudioFormat}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Bitrate" Style="{StaticResource FieldLabel}"/><Picker ItemsSource="{Binding Bitrates}" SelectedItem="{Binding SelectedConvertBitrate}"/></VerticalStackLayout></Grid>
  <HorizontalStackLayout HorizontalOptions="End" Spacing="8"><Button Text="Iniciar" ImageSource="action_play.png" Style="{StaticResource PrimaryButton}" Clicked="Start" IsEnabled="{Binding CanStartConversions}"/><Button Text="Pausar" ImageSource="action_pause.png" Style="{StaticResource SecondaryButton}" Clicked="Stop" IsEnabled="{Binding IsBusy}"/><Button Text="Continuar" ImageSource="action_resume.png" Style="{StaticResource SecondaryButton}" Clicked="Start" IsEnabled="{Binding CanResume}"/></HorizontalStackLayout>
 </VerticalStackLayout></Border></VerticalStackLayout></ScrollView><Border Grid.Row="1" Style="{StaticResource Card}" Padding="14"><VerticalStackLayout><Grid ColumnDefinitions="Auto,*,Auto"><Label Text="Pasta de saída" Style="{StaticResource FieldLabel}" VerticalOptions="Center"/><Entry Grid.Column="1" Text="{Binding OutputDirectory}" Margin="10,0"/><Button Grid.Column="2" Text="Escolher" ImageSource="action_folder.png" Style="{StaticResource SecondaryButton}" Clicked="Output"/></Grid><ProgressBar Progress="{Binding Progress}"/><Label Text="{Binding Status}" FontSize="11" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout></Border></Grid>
</ContentPage>
