<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ConverPro.Pages.ActivityPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:ConverPro.Models" xmlns:vm="clr-namespace:ConverPro.ViewModels" x:DataType="vm:MainViewModel" Title="Atividades e falhas">
 <Grid Padding="30,16" RowDefinitions="Auto,Auto,*" RowSpacing="12"><HorizontalStackLayout Spacing="8" HorizontalOptions="End"><Button Text="Tentar falhas novamente" ImageSource="action_resume.png" Style="{StaticResource SecondaryButton}" Clicked="Retry"/><Button Text="Limpar histórico" ImageSource="action_remove.png" Style="{StaticResource DangerButton}" Clicked="Clear"/></HorizontalStackLayout>
  <Grid Grid.Row="1" ColumnDefinitions="75,100,*,100,2*" Padding="12,8" BackgroundColor="#E9EEF7"><Label Text="Horário" FontAttributes="Bold"/><Label Grid.Column="1" Text="Operação" FontAttributes="Bold"/><Label Grid.Column="2" Text="Item" FontAttributes="Bold"/><Label Grid.Column="3" Text="Status" FontAttributes="Bold"/><Label Grid.Column="4" Text="Mensagem" FontAttributes="Bold"/></Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><CollectionView ItemsSource="{Binding Logs}"><CollectionView.EmptyView><Label Text="Nenhuma atividade registrada nesta sessão." Style="{StaticResource EmptyLabel}"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="models:ActivityLog"><Grid ColumnDefinitions="75,100,*,100,2*" Padding="12,10"><Label Text="{Binding Time, StringFormat='{0:HH:mm:ss}'}"/><Label Grid.Column="1" Text="{Binding Operation}"/><Label Grid.Column="2" Text="{Binding Item}" LineBreakMode="TailTruncation"/><Label Grid.Column="3" Text="{Binding Status}" TextColor="{StaticResource Primary}"/><VerticalStackLayout Grid.Column="4"><Label Text="{Binding Message}"/><Label Text="{Binding TechnicalDetails}" FontSize="10" TextColor="{StaticResource TextSecondary}" MaxLines="3"/></VerticalStackLayout></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></Border>
 </Grid>
</ContentPage>
