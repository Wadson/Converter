<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ConverPro.Pages.AboutPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Sobre">
 <ScrollView><VerticalStackLayout Padding="30,24" Spacing="14">
  <Label Text="Sobre o ConverPro" Style="{StaticResource PageTitle}"/><Label Text="Informações do sistema e gerenciamento das ferramentas de mídia." Style="{StaticResource PageSubtitle}"/>
  <Border Style="{StaticResource Card}"><Grid ColumnDefinitions="80,*"><Image Source="app_logo.png" WidthRequest="64" HeightRequest="64"/><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="ConverPro" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource Primary}"/><Label x:Name="VersionLabel"/><Label Text="Conversor e gerenciador de mídia desenvolvido pela WR Soft." TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout></Grid></Border>
  <Border Style="{StaticResource Card}"><Grid ColumnDefinitions="*,*" ColumnSpacing="24"><VerticalStackLayout Spacing="5"><Label Text="Informações técnicas" FontSize="18" FontAttributes="Bold"/><Label x:Name="BuildLabel"/><Label x:Name="PlatformLabel"/><Label x:Name="OsLabel"/><Label x:Name="ArchitectureLabel"/><Label x:Name="FrameworkLabel"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center"><Label Text="Desenvolvido por WR Soft Serviços Online" FontAttributes="Bold" FontSize="16"/><Label Text="Copyright © 2026" TextColor="{StaticResource TextSecondary}"/><Label Text="Todos os direitos reservados." TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout></Grid></Border>
  <Label Text="Ferramentas de mídia" FontSize="20" FontAttributes="Bold" Margin="0,6,0,0"/>
  <Border Style="{StaticResource Card}" Padding="16"><Grid ColumnDefinitions="*,170,110" ColumnSpacing="12"><VerticalStackLayout><Label Text="yt-dlp" FontAttributes="Bold" FontSize="16"/><Label Text="Downloads de vídeos e playlists" TextColor="{StaticResource TextSecondary}" FontSize="12"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label x:Name="YtStatus" FontAttributes="Bold"/><Label x:Name="YtVersion" FontSize="11" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout><Button x:Name="YtButton" Grid.Column="2" Text="Verificando..." Style="{StaticResource SecondaryButton}" Clicked="InstallYt"/></Grid></Border>
  <Border Style="{StaticResource Card}" Padding="16"><Grid ColumnDefinitions="*,170,110" ColumnSpacing="12"><VerticalStackLayout><Label Text="FFmpeg" FontAttributes="Bold" FontSize="16"/><Label Text="Conversão, compressão e mesclagem" TextColor="{StaticResource TextSecondary}" FontSize="12"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label x:Name="FfmpegStatus" FontAttributes="Bold"/><Label x:Name="FfmpegVersion" FontSize="11" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout><Button x:Name="FfmpegButton" Grid.Column="2" Text="Verificando..." Style="{StaticResource SecondaryButton}" Clicked="InstallFfmpeg"/></Grid></Border>
  <Border Style="{StaticResource Card}" Padding="16"><Grid ColumnDefinitions="*,170,110" ColumnSpacing="12"><VerticalStackLayout><Label Text="Deno" FontAttributes="Bold" FontSize="16"/><Label Text="Suporte JavaScript para o YouTube" TextColor="{StaticResource TextSecondary}" FontSize="12"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label x:Name="DenoStatus" FontAttributes="Bold"/><Label x:Name="DenoVersion" FontSize="11" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout><Button x:Name="DenoButton" Grid.Column="2" Text="Verificando..." Style="{StaticResource SecondaryButton}" Clicked="InstallDeno"/></Grid></Border>
  <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="*,Auto"><Label Text="Status das ferramentas" FontAttributes="Bold" FontSize="16"/><Label x:Name="ProgressPercent" Grid.Column="1" Text="0%"/></Grid><ProgressBar x:Name="InstallProgress"/><Label x:Name="ProgressStage" Text="Nenhuma operação em andamento." TextColor="{StaticResource TextSecondary}"/><Label x:Name="ProgressBytes" FontSize="11" TextColor="{StaticResource TextSecondary}"/><Button x:Name="RetryButton" Text="Tentar novamente" Style="{StaticResource DangerButton}" HorizontalOptions="Start" IsVisible="False" Clicked="Retry"/></VerticalStackLayout></Border>
  <HorizontalStackLayout Spacing="8"><Button Text="Atualizar estado" ImageSource="action_refresh.png" Style="{StaticResource SecondaryButton}" Clicked="Refresh"/><Button Text="Verificar atualização do ConverPro" ImageSource="nav_update.png" Style="{StaticResource PrimaryButton}" Clicked="CheckUpdate"/></HorizontalStackLayout>
  <Label Text="Baixe conteúdo somente quando tiver autorização e respeite os direitos autorais aplicáveis." TextColor="{StaticResource TextSecondary}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
