<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
 <Style TargetType="Page" ApplyToDerivedTypes="True"><Setter Property="BackgroundColor" Value="{StaticResource PageBackground}"/></Style>
 <Style TargetType="Label"><Setter Property="FontFamily" Value="OpenSansRegular"/><Setter Property="TextColor" Value="{StaticResource TextPrimary}"/><Setter Property="FontSize" Value="14"/></Style>
 <Style x:Key="PageTitle" TargetType="Label"><Setter Property="FontSize" Value="28"/><Setter Property="FontAttributes" Value="Bold"/></Style>
 <Style x:Key="PageSubtitle" TargetType="Label"><Setter Property="TextColor" Value="{StaticResource TextSecondary}"/></Style>
 <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="FontAttributes" Value="Bold"/><Setter Property="TextColor" Value="#334155"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="{StaticResource Surface}"/><Setter Property="Stroke" Value="{StaticResource BorderColor}"/><Setter Property="StrokeThickness" Value="1"/><Setter Property="Padding" Value="20"/><Setter Property="StrokeShape" Value="RoundRectangle 14"/></Style>
 <Style TargetType="Entry"><Setter Property="BackgroundColor" Value="White"/><Setter Property="TextColor" Value="{StaticResource TextPrimary}"/><Setter Property="PlaceholderColor" Value="#94A3B8"/><Setter Property="MinimumHeightRequest" Value="44"/></Style>
 <Style TargetType="Picker"><Setter Property="BackgroundColor" Value="White"/><Setter Property="TextColor" Value="{StaticResource TextPrimary}"/><Setter Property="MinimumHeightRequest" Value="44"/></Style>
 <Style TargetType="Button"><Setter Property="FontFamily" Value="OpenSansSemibold"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="16,10"/><Setter Property="MinimumHeightRequest" Value="44"/><Setter Property="MinimumWidthRequest" Value="44"/></Style>
 <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter Property="TextColor" Value="White"/></Style>
 <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}"/><Setter Property="TextColor" Value="{StaticResource PrimaryHover}"/></Style>
 <Style x:Key="DangerButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource DangerSoft}"/><Setter Property="TextColor" Value="{StaticResource Danger}"/></Style>
 <Style x:Key="EmptyLabel" TargetType="Label"><Setter Property="TextColor" Value="#94A3B8"/><Setter Property="HorizontalTextAlignment" Value="Center"/><Setter Property="Padding" Value="20,34"/></Style>
 <Style TargetType="ProgressBar"><Setter Property="ProgressColor" Value="{StaticResource Primary}"/></Style>
 <Style TargetType="Shell" ApplyToDerivedTypes="True"><Setter Property="Shell.BackgroundColor" Value="{StaticResource Sidebar}"/><Setter Property="Shell.ForegroundColor" Value="White"/><Setter Property="Shell.TitleColor" Value="White"/><Setter Property="Shell.UnselectedColor" Value="{StaticResource SidebarText}"/><Setter Property="Shell.DisabledColor" Value="#64748B"/><Setter Property="Shell.NavBarHasShadow" Value="False"/></Style>
</ResourceDictionary>
