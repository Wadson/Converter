<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="ConverPro.MainPage" BackgroundColor="#F4F7FB" Title="ConverPro">
 <ContentPage.Resources>
  <Style x:Key="Nav" TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="TextColor" Value="#B9C6DB"/><Setter Property="HorizontalOptions" Value="Fill"/><Setter Property="Padding" Value="17,12"/><Setter Property="CornerRadius" Value="10"/><Setter Property="ContentLayout" Value="Left,14"/><Setter Property="HeightRequest" Value="48"/></Style>
  <Style x:Key="NavItem" TargetType="Border"><Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="StrokeThickness" Value="0"/><Setter Property="Padding" Value="17,0"/><Setter Property="HeightRequest" Value="48"/><Setter Property="StrokeShape" Value="RoundRectangle 10"/><Setter Property="HorizontalOptions" Value="Fill"/></Style>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="BackgroundColor" Value="#5965E9"/><Setter Property="TextColor" Value="White"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HeightRequest" Value="46"/></Style>
  <Style x:Key="Heading" TargetType="Label"><Setter Property="FontSize" Value="30"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="TextColor" Value="#172033"/></Style>
  <Style x:Key="Field" TargetType="Label"><Setter Property="FontAttributes" Value="Bold"/><Setter Property="TextColor" Value="#39445A"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="White"/><Setter Property="Stroke" Value="#E1E7F0"/><Setter Property="StrokeThickness" Value="1"/><Setter Property="Padding" Value="24"/><Setter Property="StrokeShape" Value="RoundRectangle 16"/></Style>
 </ContentPage.Resources>
 <Grid ColumnDefinitions="245,*">
  <VerticalStackLayout BackgroundColor="#172033" Padding="20,26" Spacing="7">
   <Label Text="CONVERPRO" TextColor="White" FontSize="24" FontAttributes="Bold" Margin="9,0"/>
   <Label Text="Vídeo e áudio sem complicação" TextColor="#8FA0BB" FontSize="12" Margin="9,0,0,22"/>
   <Border x:Name="DownloadNav" Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="ShowDownload"/></Border.GestureRecognizers><Grid ColumnDefinitions="30,*" ColumnSpacing="12"><Label Text="&#xF019;" FontFamily="FontAwesomeSolid" FontSize="22" TextColor="#C8D3E5" VerticalOptions="Center" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="Baixar do YouTube" TextColor="#B9C6DB" VerticalOptions="Center"/></Grid></Border>
   <Border x:Name="ConvertNav" Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="ShowConvert"/></Border.GestureRecognizers><Grid ColumnDefinitions="30,*" ColumnSpacing="12"><Label Text="&#xF03D;" FontFamily="FontAwesomeSolid" FontSize="21" TextColor="#C8D3E5" VerticalOptions="Center" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="Converter vídeos" TextColor="#B9C6DB" VerticalOptions="Center"/></Grid></Border>
   <Border x:Name="CompressNav" Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="ShowCompress"/></Border.GestureRecognizers><Grid ColumnDefinitions="30,*" ColumnSpacing="12"><Label Text="&#xF066;" FontFamily="FontAwesomeSolid" FontSize="21" TextColor="#C8D3E5" VerticalOptions="Center" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="Comprimir MP3" TextColor="#B9C6DB" VerticalOptions="Center"/></Grid></Border>
   <Border x:Name="EditorNav" Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="ShowEditor"/></Border.GestureRecognizers><Grid ColumnDefinitions="30,*" ColumnSpacing="12"><Label Text="&#xF0C4;" FontFamily="FontAwesomeSolid" FontSize="22" TextColor="#C8D3E5" VerticalOptions="Center" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="Editor de áudio" TextColor="#B9C6DB" VerticalOptions="Center"/></Grid></Border>
   <Border x:Name="AboutNav" Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="ShowAbout"/></Border.GestureRecognizers><Grid ColumnDefinitions="30,*" ColumnSpacing="12"><Label Text="&#xF05A;" FontFamily="FontAwesomeSolid" FontSize="22" TextColor="#C8D3E5" VerticalOptions="Center" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="Sobre" TextColor="#B9C6DB" VerticalOptions="Center"/></Grid></Border>
   <BoxView HeightRequest="1" Color="#2B3548" Margin="0,14"/>
   <Border Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="CheckUpdate"/></Border.GestureRecognizers><Grid ColumnDefinitions="30,*" ColumnSpacing="12"><Label Text="&#xF2F1;" FontFamily="FontAwesomeSolid" FontSize="21" TextColor="#8FA0BB" VerticalOptions="Center" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="Verificar atualização" TextColor="#B9C6DB" VerticalOptions="Center"/></Grid></Border>
   <VerticalStackLayout VerticalOptions="EndAndExpand" Margin="9,0"><Label Text="WR Soft • Windows" TextColor="#8FA0BB" FontSize="12"/><Label x:Name="VersionLabel" TextColor="#60718C" FontSize="11"/></VerticalStackLayout>
  </VerticalStackLayout>
  <Grid Grid.Column="1" Padding="38,28" RowDefinitions="*,Auto">
   <ScrollView><Grid>
    <VerticalStackLayout x:Name="DownloadPanel" Spacing="18">
     <Label Text="Baixar do YouTube" Style="{StaticResource Heading}"/><Label Text="Adicione vídeos ou playlists e salve em vídeo ou áudio." TextColor="#69758A"/>
     <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="14">
      <Label Text="Link do vídeo ou playlist" Style="{StaticResource Field}"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry x:Name="UrlEntry" Placeholder="https://youtube.com/..."/><Button Grid.Column="1" Text="Adicionar à fila" Clicked="AddUrl"/></Grid>
      <CollectionView x:Name="UrlList" HeightRequest="130" SelectionMode="Multiple"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Padding="8"><Label Text="{Binding}" LineBreakMode="TailTruncation"/><Button Grid.Column="1" Text="Remover" Clicked="RemoveUrl" CommandParameter="{Binding}"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16"><VerticalStackLayout><Label Text="Salvar como" Style="{StaticResource Field}"/><Picker x:Name="DownloadKindPicker" SelectedIndexChanged="DownloadKindChanged"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Qualidade" Style="{StaticResource Field}"/><Picker x:Name="DownloadQualityPicker"/><Picker x:Name="DownloadAudioPicker" IsVisible="False"/></VerticalStackLayout></Grid>
      <Button Text="Iniciar downloads" Style="{StaticResource Primary}" HorizontalOptions="End" Clicked="StartDownload"/>
     </VerticalStackLayout></Border>
    </VerticalStackLayout>
    <VerticalStackLayout x:Name="ConvertPanel" IsVisible="False" Spacing="18"><Label Text="Converter vídeos para MP3" Style="{StaticResource Heading}"/><Label Text="Selecione vários vídeos MP4 e converta toda a fila." TextColor="#69758A"/><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="14"><Button Text="Selecionar vídeos MP4" HorizontalOptions="Start" Clicked="PickConvertFiles"/><CollectionView x:Name="ConvertList" HeightRequest="180"><CollectionView.ItemTemplate><DataTemplate><Label Text="{Binding}" Padding="7" LineBreakMode="TailTruncation"/></DataTemplate></CollectionView.ItemTemplate></CollectionView><Grid ColumnDefinitions="*,*" ColumnSpacing="16"><VerticalStackLayout><Label Text="Qualidade do MP3" Style="{StaticResource Field}"/><Picker x:Name="ConvertBitratePicker"/></VerticalStackLayout><Button Grid.Column="1" Text="Converter fila" Style="{StaticResource Primary}" VerticalOptions="End" Clicked="StartConvert"/></Grid></VerticalStackLayout></Border></VerticalStackLayout>
    <VerticalStackLayout x:Name="CompressPanel" IsVisible="False" Spacing="18"><Label Text="Comprimir arquivos MP3" Style="{StaticResource Heading}"/><Label Text="Comprima vários arquivos e mantenha os originais intactos." TextColor="#69758A"/><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="14"><Button Text="Selecionar arquivos MP3" HorizontalOptions="Start" Clicked="PickCompressFiles"/><CollectionView x:Name="CompressList" HeightRequest="180"><CollectionView.ItemTemplate><DataTemplate><Label Text="{Binding}" Padding="7" LineBreakMode="TailTruncation"/></DataTemplate></CollectionView.ItemTemplate></CollectionView><Grid ColumnDefinitions="*,*" ColumnSpacing="16"><VerticalStackLayout><Label Text="Bitrate de saída" Style="{StaticResource Field}"/><Picker x:Name="CompressBitratePicker"/></VerticalStackLayout><Button Grid.Column="1" Text="Comprimir fila" Style="{StaticResource Primary}" VerticalOptions="End" Clicked="StartCompress"/></Grid></VerticalStackLayout></Border></VerticalStackLayout>
    <VerticalStackLayout x:Name="EditorPanel" IsVisible="False" Spacing="18"><Label Text="Editor de áudio" Style="{StaticResource Heading}"/><Label Text="Recorte um trecho, ajuste o volume ou remova uma seleção." TextColor="#69758A"/><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="14"><Grid ColumnDefinitions="*,Auto"><Entry x:Name="EditorFileEntry" IsReadOnly="True" Placeholder="Escolha um áudio..."/><Button Grid.Column="1" Text="Abrir áudio" Clicked="PickEditorFile"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><VerticalStackLayout><Label Text="Início (hh:mm:ss)" Style="{StaticResource Field}"/><Entry x:Name="StartTimeEntry" Text="00:00:00"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Fim (hh:mm:ss)" Style="{StaticResource Field}"/><Entry x:Name="EndTimeEntry" Text="00:00:10"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label Text="Volume" Style="{StaticResource Field}"/><Picker x:Name="VolumePicker"/></VerticalStackLayout></Grid><HorizontalStackLayout Spacing="10"><Button Text="Exportar trecho" Style="{StaticResource Primary}" Clicked="ExportSegment"/><Button Text="Remover trecho" Clicked="RemoveSegment"/><Button Text="Aplicar volume" Clicked="ApplyVolume"/></HorizontalStackLayout></VerticalStackLayout></Border></VerticalStackLayout>
    <VerticalStackLayout x:Name="AboutPanel" IsVisible="False" Spacing="18"><Label Text="Sobre o ConverPro" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12"><Label Text="ConverPro" FontSize="26" FontAttributes="Bold" TextColor="#5965E9"/><Label Text="Conversor e gerenciador de mídia para Windows, desenvolvido pela WR Soft." TextColor="#39445A"/><Label Text="Baixe conteúdo somente quando tiver autorização e respeite os termos e direitos autorais aplicáveis." TextColor="#69758A"/><Label x:Name="AboutVersionLabel" TextColor="#69758A"/></VerticalStackLayout></Border></VerticalStackLayout>
   </Grid></ScrollView>
   <Border Grid.Row="1" Style="{StaticResource Card}" Padding="15" Margin="0,16,0,0"><VerticalStackLayout Spacing="7"><Grid ColumnDefinitions="Auto,*,Auto"><Label Text="Pasta de saída" FontAttributes="Bold" VerticalOptions="Center"/><Entry Grid.Column="1" x:Name="OutputEntry" Margin="10,0" FontSize="12"/><Button Grid.Column="2" Text="Escolher" Clicked="PickOutputFolder"/></Grid><Grid x:Name="ProgressArea" IsVisible="False" ColumnDefinitions="*,Auto"><VerticalStackLayout><ProgressBar x:Name="OperationProgressBar" ProgressColor="#5965E9"/><Label x:Name="StatusLabel" FontSize="12" TextColor="#69758A" LineBreakMode="TailTruncation"/></VerticalStackLayout><Button Grid.Column="1" Text="Cancelar" Clicked="CancelOperation"/></Grid></VerticalStackLayout></Border>
  </Grid>
 </Grid>
</ContentPage>
