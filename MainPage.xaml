<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ConverPro.MainPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:models="clr-namespace:ConverPro.Models" xmlns:vm="clr-namespace:ConverPro.ViewModels" x:DataType="vm:MainViewModel" Title="Baixar do YouTube">
 <Grid Padding="30,24" RowDefinitions="*,Auto" RowSpacing="16"><ScrollView><VerticalStackLayout Spacing="14">
  <Label Text="Baixar do YouTube" Style="{StaticResource PageTitle}"/><Label Text="Analise vídeos ou playlists e salve em vídeo ou áudio." Style="{StaticResource PageSubtitle}"/>
  <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="14">
   <Grid ColumnDefinitions="*,Auto"><Label Text="Link do vídeo ou playlist" Style="{StaticResource FieldLabel}"/><Label Grid.Column="1" Text="{Binding Downloads.Count, StringFormat='{0} itens'}" TextColor="{StaticResource Primary}" FontAttributes="Bold"/></Grid>
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry x:Name="UrlEntry" Placeholder="Cole aqui o link do YouTube" Completed="AddUrl"/><Button Grid.Column="1" Text="Analisar link" ImageSource="action_add.png" Style="{StaticResource SecondaryButton}" Clicked="AddUrl"/></Grid>
   <HorizontalStackLayout Spacing="8"><Button Text="Selecionar todos" ImageSource="action_select.png" Style="{StaticResource SecondaryButton}" Clicked="SelectAll"/><Button Text="Desmarcar todos" Style="{StaticResource SecondaryButton}" Clicked="ClearSelection"/><Button Text="Remover" ImageSource="action_remove.png" Style="{StaticResource DangerButton}" Clicked="RemoveSelected"/></HorizontalStackLayout>
   <CollectionView ItemsSource="{Binding Downloads}" HeightRequest="260"><CollectionView.EmptyView><Label Text="A fila está vazia. Adicione um link para começar." Style="{StaticResource EmptyLabel}"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate x:DataType="models:MediaQueueItem"><Border Stroke="#E5EAF1" StrokeShape="RoundRectangle 8" Padding="8" Margin="0,2"><Grid ColumnDefinitions="Auto,*,90" RowDefinitions="Auto,Auto"><CheckBox IsChecked="{Binding IsSelected}"/><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="{Binding Title}" LineBreakMode="TailTruncation"/><Label Text="{Binding PlaylistName}" FontSize="11" TextColor="{StaticResource TextSecondary}"/><Label Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="11" LineBreakMode="TailTruncation"/></VerticalStackLayout><Label Grid.Column="2" Text="{Binding StatusText}" TextColor="{StaticResource Primary}" VerticalOptions="Center"/><ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Progress="{Binding Progress}" Margin="0,4,0,0"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
   <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><VerticalStackLayout><Label Text="Salvar como" Style="{StaticResource FieldLabel}"/><Picker ItemsSource="{Binding DownloadKinds}" SelectedIndex="{Binding DownloadKindIndex}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Qualidade" Style="{StaticResource FieldLabel}"/><Picker ItemsSource="{Binding VideoQualities}" SelectedItem="{Binding SelectedVideoQuality}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label Text="Bitrate do áudio" Style="{StaticResource FieldLabel}"/><Picker ItemsSource="{Binding Bitrates}" SelectedItem="{Binding SelectedDownloadBitrate}"/></VerticalStackLayout></Grid>
   <HorizontalStackLayout HorizontalOptions="End" Spacing="8"><Button Text="Iniciar" ImageSource="action_play.png" Style="{StaticResource PrimaryButton}" Clicked="Start" IsEnabled="{Binding CanStartDownloads}"/><Button Text="Pausar" ImageSource="action_pause.png" Style="{StaticResource SecondaryButton}" Clicked="Stop" IsEnabled="{Binding IsBusy}"/><Button Text="Continuar" ImageSource="action_resume.png" Style="{StaticResource SecondaryButton}" Clicked="Start" IsEnabled="{Binding CanResume}"/></HorizontalStackLayout>
  </VerticalStackLayout></Border>
 </VerticalStackLayout></ScrollView><Border Grid.Row="1" Style="{StaticResource Card}" Padding="14"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Label Text="Pasta de saída" Style="{StaticResource FieldLabel}" VerticalOptions="Center"/><Entry Grid.Column="1" Text="{Binding OutputDirectory}"/><Button Grid.Column="2" Text="Escolher" ImageSource="action_folder.png" Style="{StaticResource SecondaryButton}" Clicked="PickOutput"/></Grid><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><ProgressBar Progress="{Binding Progress}"/><Label Text="{Binding Status}" FontSize="11" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Counter}" FontAttributes="Bold" Margin="12,0,0,0" VerticalOptions="Center"/></Grid></VerticalStackLayout></Border></Grid>
</ContentPage>
